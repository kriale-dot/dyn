APP_ENV=development
APP_DEBUG=true
APP_WEB_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syn
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_TTL_SECONDS=28800

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-do-google
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=seu-email@gmail.com
MAIL_FROM_NAME=SYN

# ============================================================
# ETAPA 101 — DESENVOLVIMENTO EM CELULAR / TABLET
# ============================================================
#
# Mantenha:
# APP_ENV=development
#
# O CorsMiddleware da Etapa 101 aceita automaticamente origens
# da rede local durante development, por exemplo:
#
# http://192.168.15.8:5173
#
# Em produção, a liberação automática é DESATIVADA e somente
# CORS_ALLOWED_ORIGINS é respeitado.
#
# Exemplo para produção:
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br

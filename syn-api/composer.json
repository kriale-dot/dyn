{
    "name": "syn/api",
    "description": "API REST do sistema SYN - Organizacao, programacao e escalas da igreja",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "6.11",
        "phpmailer/phpmailer": "6.9",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8282 -t public"
    },
    "config": {
        "sort-packages": true
    }
}

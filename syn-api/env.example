# ============================================================
# SYN API - EXEMPLO DE CONFIGURAÇÃO
# ============================================================
#
# Copie este arquivo para:
#
# .env
#
# e ajuste os valores de acordo com o ambiente.
#
# NUNCA coloque senhas ou segredos reais neste arquivo de exemplo.
# ============================================================

# ------------------------------------------------------------
# APLICAÇÃO
# ------------------------------------------------------------

APP_ENV=development
APP_DEBUG=true

# ------------------------------------------------------------
# BANCO DE DADOS
# ------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syn
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
# AUTENTICAÇÃO JWT
# ------------------------------------------------------------

# Gere uma chave segura com:
#
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
JWT_SECRET=648b1e2bfd41816d8857f68035dba0adec084c407be0f093c74cece33e7e48c4

# 3600 segundos = 1 hora
JWT_TTL_SECONDS=3600